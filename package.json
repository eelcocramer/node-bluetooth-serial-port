{
    "name": "bluetooth-serial-port",
    "version": "3.0.5",
    "description": "Bluetooth serial port communication for Node.js",
    "author": "Eelco Cramer <eelco@hailendal.org>",
    "keywords": [
        "bluetooth",
        "serial port",
        "rfcomm",
        "darwin",
        "linux",
        "windows"
    ],
    "homepage": "https://github.com/eelcocramer/node-bluetooth-serial-port",
    "bugs": "https://github.com/eelcocramer/node-bluetooth-serial-port/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eelcocramer/node-bluetooth-serial-port.git"
    },
    "directories": {
        "lib": "./lib"
    },
    "main": "./lib/bluetooth-serial-port.js",
    "types": "./lib/bluetooth-serial-port.d.ts",
    "files": [
        "lib/",
        "src/",
        "scripts/",
        "binding.gyp",
        "prebuilds/"
    ],
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "dependencies": {
        "nan": "^2.28.0",
        "node-gyp-build": "^4.8.4"
    },
    "devDependencies": {},
    "optionalDependencies": {
        "@types/node": "^26.1.2"
    },
    "engines": {
        "node": ">= 18.x",
        "npm": ">= 8.x"
    },
    "scripts": {
        "install": "node scripts/install-native.js",
        "install-release": "node-gyp configure build",
        "install-debug": "node-gyp configure build --debug",
        "prebuild": "node scripts/create-prebuilds.js --strip",
        "prepublishOnly": "node scripts/download-prebuilds.js",
        "test": "node test/index.js"
    },
    "license": "MIT",
    "contributors": [
        "Eric Smekens",
        "Juho Vepsäläinen",
        "Elmar Langholz",
        "Donald Ness",
        "Joost Verdoorn",
        "Max Metral",
        "Thomas Wickham",
        "Adrián Estrada",
        "Juan Gomez",
        "Eric Lundby",
        "Kevin Clarens"
    ]
}
